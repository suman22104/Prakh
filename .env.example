# ==============================================================================
# Parakh — Environment Variables
# Copy this file to .env for local development. Never commit .env to git.
# ==============================================================================

# --- Server Runtime ---
# Port the Express server listens on (Render sets PORT automatically)
PORT=3000
# Set to "production" when deploying
NODE_ENV=development

# --- AI Provider (Optional: falls back to local rules-only mode if omitted) ---
# Supported: gemini | groq | ollama | rules
AI_PROVIDER=gemini
# Required only if AI_PROVIDER=gemini (free tier available at aistudio.google.com)
GEMINI_API_KEY=
# Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative AI providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- CORS & Deployment URLs ---
# Primary deployed URL (e.g. https://parakh.onrender.com)
APP_URL=http://localhost:3000
# Comma-separated list of additional allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Reviewer Admin (Optional) ---
# Google account email allowed to access /reviewer.
# IMPORTANT: Vite bakes VITE_ADMIN_EMAIL into the frontend bundle at build time,
# so set this BEFORE running `npm run build`.
ADMIN_EMAIL=
VITE_ADMIN_EMAIL=
